{
  "$schema": "https://mintlify.com/docs.json",
  "name": "StateWeave",
  "description": "A small TypeScript SDK for persistent agents built on an immutable causal graph.",
  "theme": "maple",
  "colors": {
    "primary": "#f06a4f",
    "light": "#f47b63",
    "dark": "#ff8067"
  },
  "logo": {
    "light": "/logo-light.svg",
    "dark": "/logo-dark.svg",
    "href": "/introduction"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "light"
  },
  "background": {
    "color": {
      "light": "#f4f7f1",
      "dark": "#0d1510"
    }
  },
  "fonts": {
    "heading": {
      "family": "Geist",
      "weight": 600
    },
    "body": {
      "family": "Geist",
      "weight": 400
    }
  },
  "icons": {
    "library": "tabler"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": {
        "light": "vitesse-light",
        "dark": "vitesse-dark"
      }
    }
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/stateweave/sdk-typescript"
      },
      {
        "label": "StateWeave AI",
        "href": "https://stateweave.ai"
      }
    ]
  },
  "navigation": {
    "groups": [
      {
        "group": "Start",
        "pages": ["introduction", "quickstart"]
      },
      {
        "group": "Understand",
        "pages": ["concepts/why-stateweave", "concepts/nodes", "concepts/the-turn", "concepts/projection"]
      },
      {
        "group": "Build",
        "pages": ["guides/tools", "guides/models", "guides/persist-and-stream", "examples/complete-agent"]
      },
      {
        "group": "Reference",
        "pages": ["reference/agent", "reference/types"]
      }
    ]
  },
  "search": {
    "prompt": "Search the manual"
  },
  "contextual": {
    "options": ["copy"],
    "display": "toc"
  },
  "seo": {
    "indexing": "navigable"
  },
  "redirects": [
    { "source": "/", "destination": "/introduction", "permanent": false },
    { "source": "/guides/models-and-tools", "destination": "/guides/tools", "permanent": true },
    { "source": "/concepts/agent-state", "destination": "/concepts/nodes", "permanent": true },
    { "source": "/concepts/how-it-works", "destination": "/concepts/the-turn", "permanent": true }
  ],
  "errors": {
    "404": {
      "redirect": false,
      "title": "This thread ends here.",
      "description": "The page is not part of the current StateWeave manual. [Return to the introduction](/introduction)."
    }
  },
  "markdown": {
    "instructions": "StateWeave exposes one public agent class, Agent. AgentState is the lossless persistence format. The graph is canonical truth; each prompt is a bounded projection."
  }
}
